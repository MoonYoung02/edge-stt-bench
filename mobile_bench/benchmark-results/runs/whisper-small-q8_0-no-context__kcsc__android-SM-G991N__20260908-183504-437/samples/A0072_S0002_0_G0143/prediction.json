    {
      "start": 623.0,
      "end": 624.0,
      "text": "그래서"
    },
    {
      "start": 625.0,
      "end": 627.0,
      "text": "그렇게까지"
    },
    {
      "start": 628.0,
      "end": 630.0,
      "text": "열심히 공부하기 만들었으면"
