    {
      "start": 702.0,
      "end": 704.0,
      "text": "같이 평준할 거면"
    },
    {
      "start": 704.0,
      "end": 705.0,
      "text": "애초에"
    },
    {
      "start": 705.0,
      "end": 707.0,
      "text": "과학거나 외곤과 같이 했어야 됐어"
