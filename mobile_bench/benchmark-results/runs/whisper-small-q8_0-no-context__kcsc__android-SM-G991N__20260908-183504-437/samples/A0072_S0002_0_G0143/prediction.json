    {
      "start": 630.0,
      "end": 632.0,
      "text": "대학교 가서"
    },
    {
      "start": 633.0,
      "end": 635.0,
      "text": "더 잘해줘야 되는 거 아니야?"
    },
    {
      "start": 645.0,
      "end": 647.0,
      "text": "옛날부터 대학이 너무 중심적이었어"
