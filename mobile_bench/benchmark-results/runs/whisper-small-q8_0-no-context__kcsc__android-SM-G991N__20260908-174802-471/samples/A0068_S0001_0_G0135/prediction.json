    {
      "start": 856.0,
      "end": 858.0,
      "text": "그"
    },
    {
      "start": 858.0,
      "end": 860.0,
      "text": "어 근데 그 어 그러니까"
    },
    {
      "start": 860.0,
      "end": 862.0,
      "text": "그게 문..그래가지고"
    },
    {
      "start": 862.0,
      "end": 864.0,
      "text": "그 사장언니가 전문가한테"
    },
    {
      "start": 864.0,
      "end": 866.0,
      "text": "조언을 구했더니"
    },
    {
      "start": 866.0,
      "end": 868.0,
      "text": "그게 기계가 기계에"
    },
    {
      "start": 868.0,
      "end": 870.0,
      "text": "좋은 기계의 기준이 뭐냐"
    },
    {
      "start": 870.0,
      "end": 872.0,
      "text": "하니까 그 뭐"
    },
    {
      "start": 872.0,
      "end": 874.0,
      "text": "외부에 영향을 받지 않고"
    },
    {
      "start": 874.0,
      "end": 876.0,
      "text": "일정한 온도를"
    },
    {
      "start": 876.0,
      "end": 878.0,
      "text": "유지를 할 수 있는 기계가"
    },
    {
      "start": 878.0,
      "end": 880.0,
      "text": "좋은 기계라는거야"
    },
    {
      "start": 880.0,
      "end": 882.0,
      "text": "그러니까 어"
    },
    {
      "start": 882.0,
      "end": 884.0,
      "text": "어 외부에 영향을 받지 않고"
    },
    {
      "start": 884.0,
      "end": 886.0,
      "text": "그러니까 얼마 그러니까 계속"
    },
    {
      "start": 886.0,
      "end": 888.0,
      "text": "커피를 뽑거나 그러면 얘가"
    },
    {
      "start": 888.0,
      "end": 890.0,
      "text": "일을 계속하니까 약간"
    },
    {
      "start": 890.0,
      "end": 892.0,
      "text": "외부에 영향을 받아서"
    },
    {
      "start": 892.0,
      "end": 894.0,
      "text": "약간 온도가 높아지거나 낮아지거나"
    },
    {
      "start": 894.0,
      "end": 896.0,
      "text": "이럴 수가 있는데 그 커피 머신"
    },
    {
      "start": 896.0,
      "end": 898.0,
      "text": "브레스 머신 있잖아"
    },
    {
      "start": 898.0,
      "end": 900.0,
      "text": "근데 그거에 영향을 받지 않고"
    },
    {
      "start": 900.0,
      "end": 902.0,
      "text": "어 일정하게"
    },
    {
      "start": 902.0,
      "end": 904.0,
      "text": "그 온도를 유지할 수 있는"
    },
    {
      "start": 904.0,
      "end": 906.0,
      "text": "기계가 좋은 기계라는거지"
    },
    {
      "start": 906.0,
      "end": 908.0,
      "text": "그래서 내가 그 말을 듣고"
    },
    {
      "start": 908.0,
      "end": 910.0,
      "text": "아 기계가 사람이랑 똑같네"
    },
    {
      "start": 910.0,
      "end": 912.0,
      "text": "라고 생각했거든"
    },
    {
      "start": 912.0,
      "end": 914.0,
      "text": "15분 지났다"
    },
    {
      "start": 914.0,
      "end": 916.0,
      "text": "어"
    },
    {
      "start": 916.0,
      "end": 918.0,
      "text": "아니아니 사람이나 기계가"
    },
    {
      "start": 918.0,
      "end": 920.0,
      "text": "기계가 사람이랑 똑같다"
    },
    {
      "start": 920.0,
      "end": 922.0,
      "text": "정지"
    },
